# Beim ersten Start eigene lange Passwörter eintragen; niemals diese Datei ins Git übernehmen.
VV_ADMIN_PASSWORD=HIER_EIN_LANGES_ADMIN_PASSWORT
VV_VIEWER_PASSWORD=HIER_EIN_LANGES_VIEWER_PASSWORT
VV_KASSE_PASSWORD=HIER_EIN_LANGES_KASSE_PASSWORT
VV_SESSION_SECRET=HIER_EIN_ZUFAELLIGER_SECRET_MIT_MINDESTENS_32_ZEICHEN
# Browser braucht HTTPS (oder localhost) für installierbare PWA.
# Hinter Cloudflare Tunnel / HTTPS-Reverse-Proxy true lassen; lokaler HTTP-Test ggf. false.
VV_COOKIE_SECURE=true
VV_BIND_IP=127.0.0.1
VV_PORT=3000
